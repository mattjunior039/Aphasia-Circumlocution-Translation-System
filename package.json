{
  "name": "wordbridge",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "data:build": "node scripts/build-vocabulary.mjs",
    "models:build": "node scripts/build-semantic-index.mjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "test:offline": "playwright test -c playwright.production.config.js",
    "benchmark": "node scripts/benchmark.mjs",
    "benchmark:semantic": "node scripts/benchmark.mjs --semantic"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "vite": "8.3.3",
    "wordnet-db": "3.1.14"
  }
}
